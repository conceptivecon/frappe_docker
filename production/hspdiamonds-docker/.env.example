# Docker image to run
CUSTOM_IMAGE=frappe/erpnext
CUSTOM_TAG=v15

# Primary site
SITE_NAME=erp.hspdiamonds.com
SITE_DB_NAME=erp_hspdiamonds_com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_DB_ROOT_PASSWORD

# Mutable custom app (git pull based updates)
CUSTOM_APP_REPO=git@github.com:conceptivecon/jewelry-erp.git
CUSTOM_APP_BRANCH=version-15
CUSTOM_APP_NAME=hspdiamonds

# Frontend bind port (behind reverse proxy)
HTTP_PORT=8080

# Base64 of apps.json (generated by scripts/deploy.sh)
APPS_JSON_BASE64=
