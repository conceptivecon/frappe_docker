# Docker image to run
CUSTOM_IMAGE=yourcompany/erpnext-jewelry
CUSTOM_TAG=latest

# Primary site
SITE_NAME=erp.hspdiamonds.com
SITE_DB_NAME=erp_hspdiamonds_com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_DB_ROOT_PASSWORD

# Frontend bind port (behind reverse proxy)
HTTP_PORT=8080

# Base64 of apps.json (generated by scripts/deploy.sh)
APPS_JSON_BASE64=
